{
  "entities": {
    "User": {
      "title": "User",
      "description": "User accounts with system roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "User"] },
        "photo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "name", "role"]
    },
    "Income": {
      "title": "Income",
      "description": "Income records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "category", "source"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense records with workflow approvals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "attachment": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "managerNote": { "type": "string" },
        "adminNote": { "type": "string" },
        "deductedAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "category", "source", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notifications for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "isRead"]
    },
    "Todo": {
      "title": "Todo",
      "description": "Individual todo list items.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "isCompleted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles database."
    },
    "/income/{incomeId}": {
      "schema": "Income",
      "description": "All tracked income logs."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Exhaustive logs of all business and task expenses."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Targeted notifications stream."
    },
    "/todos/{todoId}": {
      "schema": "Todo",
      "description": "ERP wide general todos."
    }
  }
}
